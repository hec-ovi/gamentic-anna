{
  "schema": 2,
  "permissions": ["tools.invoke", "llm.complete"],
  "required_executas": [
    { "tool_id": "tool-gamentic-engine-7h8aweky", "min_version": "0.4.0", "version": "0.4.0" }
  ],
  "system_prompt_addendum": "When the user wants to play or build a text adventure, summon the game window via open_app_view('play').",
  "ui": {
    "bundle": { "format": "static-spa", "entry": "index.html" },
    "views": [
      {
        "name": "play",
        "title": "Gamentic",
        "default": true,
        "default_size": { "w": 1280, "h": 860 },
        "min_size": { "w": 360, "h": 560 },
        "max_size": { "w": 1366, "h": 1400 },
        "resizable": true,
        "movable": true
      }
    ],
    "host_api": {
      "tools": ["required:*"],
      "llm": ["complete"],
      "image": ["generate", "edit"],
      "window": ["set_title", "open_view"],
      "agent": { "session": { "auto": true }, "tools": [] }
    }
  }
}
