# Gamentic-on-Anna (native). Copy to .env to override defaults; defaults are sane.
#   cp .env.example .env && docker compose up -d --build
#
# Sign in once after first start (the token persists on the anna-cred volume):
#   docker exec -it gamentic-anna anna-app login --host https://anna.partners --no-browser

# Host port for the game window (the anna-app dev dashboard), bound to 127.0.0.1.
APP_PORT=5180
