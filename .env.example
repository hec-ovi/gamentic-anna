# Gamentic-on-Anna container stack. Copy to .env and adjust; defaults are sane.
#   cp .env.example .env && docker compose up -d --build

# Host port for the app (the Anna dev dashboard / game window), bound to 127.0.0.1
APP_PORT=5180

# Text model id the bridge advertises (echoed in completions). Leave as-is.
ANNA_TEXT_MODEL=anna-copilot

# Image via Anna (EXPERIMENTAL). false = text-only play (recommended v1).
# true = anna-api asks the copilot to generate an image (unverified).
ANNA_IMAGE_VIA_COPILOT=false

# Optional headless agent sign-in. Leave blank to sign in once in the Web UI at
# http://localhost:19001 (the session then persists on the anna-data volume).
ANNA_AGENT_USERNAME=
ANNA_AGENT_PASSWORD=
